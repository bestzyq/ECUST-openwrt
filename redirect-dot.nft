chain redirect_dot {
    type nat hook prerouting priority dstnat;

    # LAN / Wi-Fi
    iifname "br-lan" tcp dport 853 redirect to 854

    # WAN (外部访问路由器自身)
    iifname "pppoe-wan" tcp dport 853 redirect to 855

    # WAN (外部访问路由器自身) - DNS over UDP
    iifname "pppoe-wan" udp dport 53 redirect to 54
}
